# URL và publishable key từ cài đặt API của dự án Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chỉ phía máy chủ. Dùng secret key hoặc khóa service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Tạo bằng openssl rand -hex 32, giữ nguyên giữa các lần triển khai.
UPLOAD_RATE_LIMIT_SECRET=
